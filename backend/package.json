{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "API et panneau de gestion de la Grande Offensive",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test",
    "prisma:format": "prisma format --schema prisma/schema.prisma --config prisma.config.ts",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma --config prisma.config.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma --config prisma.config.ts",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma --config prisma.config.ts",
    "admin:create": "node scripts/create-admin.js",
    "data:purge": "node scripts/purge-personal-data.js"
  },
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemon": "^3.1.14",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
