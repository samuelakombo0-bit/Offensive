# Remplacer ces valeurs par les paramètres PostgreSQL de l’environnement local.
DATABASE_URL="postgresql://postgres:NouveauMotDePasse123!@127.0.0.1:5432/offensive"

# Le fuseau doit être confirmé par l’organisation avant la mise en production.
EVENT_TIME_ZONE="UTC"

# Le cookie est non-Secure uniquement en développement HTTP local.
NODE_ENV="development"
PORT="3000"
SESSION_TTL_DAYS="30"
UPLOAD_DIR="./private-uploads"

# Passer à true derrière un proxy HTTPS correctement configuré.
COOKIE_SECURE="false"
TRUST_PROXY="false"
